<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <h2><%= project.title %></h2>

    <p>
        Description: <%= project.description %>
    </p>

    <p>
        Date: <%= project.project_date %>
    </p>

    <p>
        Location: <%= project.location %>
    </p>

    <p>
        Partner Organization:
        <a href="/organization/<%= project.organization_id %>">
            <%= project.organization_name %>
        </a>
    </p>

    <a href="/edit-project/<%= project.project_id %>">
        Edit Project
    </a>

    <h3>Categories</h3>

    <% if (categories.length > 0) { %>
        <ul>
            <% categories.forEach(category => { %>
                <li>
                    <a href="/category/<%= category.category_id %>">
                        <%= category.name %>
                    </a>
                </li>
            <% }); %>
        </ul>
    <% } else { %>
        <p>No categories assigned to this project.</p>
    <% } %>

    <a href="/assign-categories/<%= project.project_id %>">
         Edit Categories
    </a>
</main>

<%- include('partials/footer') %>