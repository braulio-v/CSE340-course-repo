<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>
    <h2>Upcoming Service Projects</h2>
    <ul>
        <% projects.forEach(project => { %>
            <%
                const formattedDate = project.project_date.toLocaleDateString('en-US', {
                    timeZone: 'UTC',
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric'
                });
            %>
            <li>
                <%= formattedDate %>:
                <%= project.title %>
                (<%= project.organization_name %>)
            </li>
        <% }) %>
    </ul>
</main>

<%- include('partials/footer') %>
