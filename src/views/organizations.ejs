<%- include('partials/header') %>

    <main>
        <h1><%= title %></h1>
        <p>Here are a few of our partner organizations:</p>
        <ul>
            <% organizations.forEach(org => { %>
                <li>
                    <img src="/images/<%= org.logo_filename %>" alt="<%= org.name %> logo">
                    <a href="/organization/<%= org.organization_id %>"><%= org.name %></a>: <%= org.contact_email %>
                </li>
            <% }); %>
        </ul>
        <h2>Add a New Organization</h2>

<form action="/organization" method="POST">
    <div>
        <label for="name">Organization Name:</label>
        <input
            type="text"
            id="name"
            name="name"
            required
        >
    </div>

    <div>
        <label for="description">Description:</label>
        <textarea
            id="description"
            name="description"
            required
        ></textarea>
    </div>

    <div>
        <label for="contactEmail">Contact Email:</label>
        <input
            type="email"
            id="contactEmail"
            name="contactEmail"
            required
        >
    </div>

    <button type="submit">Add Organization</button>
</form>
    </main>

<%- include('partials/footer') %>
