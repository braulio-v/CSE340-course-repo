<%- include('partials/header') %>

    <main>
        <h1><%= title %></h1>
        <h2>Explore Our Service Project Categories</h2>
         <p>
            Discover different ways to make a positive impact
            in your community through service and volunteering.
        </p>
        <a href="/new-category">Create New Category</a>
        <ul>
             <% categories.forEach(category => { %>

            <li>
                <a href="/category/<%= category.category_id %>">
                    <%= category.name %>
                </a>
            </li>
            <a href="/edit-category/<%= category.category_id %>">
                    Edit Category
                </a>

            <% }); %>
        </ul>
    </main>

<%- include('partials/footer') %>
