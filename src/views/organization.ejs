
<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <h2><%= organizationDetails.name %></h2>

    <p>
        Description: <%= organizationDetails.description %>
    </p>

    <p>
        Contact Email: <%= organizationDetails.contact_email %>
    </p>

    <img
        src="/images/<%= organizationDetails.logo_filename %>"
        alt="<%= organizationDetails.name %> logo"
    >

    <section>
        <h2>Service Projects from this Organization</h2>

        <% if (projects.length > 0) { %>

            <ul>
                <% projects.forEach(project => { %>

                    <li>
                        <a href="/project/<%= project.project_id %>">
                            <%= project.title %>
                        </a>
                    </li>

                <% }); %>
            </ul>

        <% } else { %>

            <p>This organization does not have any service projects yet.</p>

        <% } %>
    </section>

    <p>
        <a href="/edit-organization/<%= organizationDetails.organization_id %>">
            Edit Organization
        </a>
    </p>
</main>

<%- include('partials/footer') %>
